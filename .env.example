# npm run dev uses Vite at http://localhost:5173 and the API at http://localhost:3001.
# docker compose reads this file when copied to .env.
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
ENABLE_DEMO=true
# The encryption key is generated on first boot in data/.key (permissions 0600).
# Optional for non-Docker deployments: SESSION_KEY=64_hex_characters
# DATA_DIR=data

# MCP listens only on 127.0.0.1 inside the application container.
ENABLE_MCP=false
MCP_PORT=3002
